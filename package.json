{
  "name": "hackademy",
  "version": "1.0.0",
  "private": true,
  "description": "Hackademy — l'enquête web en 3D qui apprend la cybersécurité (React + Three.js, Node.js/Express, SQLite)",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "test": "npm test -w server && npm test -w client",
    "lint": "eslint .",
    "format": "prettier --write \"client/src/**/*.{js,jsx,css}\" \"client/*.{js,html}\" \"server/**/*.js\" \"*.mjs\" \"e2e/**/*.mjs\"",
    "format:check": "prettier --check \"client/src/**/*.{js,jsx,css}\" \"client/*.{js,html}\" \"server/**/*.js\" \"*.mjs\" \"e2e/**/*.mjs\"",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.64.1",
    "concurrently": "9.1.2",
    "eslint": "9.17.0",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "prettier": "3.4.2"
  }
}
