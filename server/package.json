{
  "name": "@hackademy/server",
  "version": "1.0.0",
  "private": true,
  "description": "API Hackademy : comptes, vérification des réponses, score et progression (Express + SQLite)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "compression": "1.7.5",
    "express": "4.21.2"
  }
}
